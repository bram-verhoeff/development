# Kopieer naar frontend/.env.local en vul in.

# Adres van de FastAPI-backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Publiek adres van deze frontend (voor links in bevestigings- en herstelmails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API Keys): project-URL en de publishable key
# (oudere projecten: de "anon" key). Deze sleutel mag publiek zijn.
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
