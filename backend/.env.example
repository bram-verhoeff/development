# Kopieer naar backend/.env en vul in. Zet .env nooit in git.

# Database: lokaal SQLite; online de Postgres-connection string van Supabase
# (Project Settings → Database → Connection string, "Session pooler"), met postgresql+psycopg://
DATABASE_URL=sqlite:///./contentroom.db

# Frontend-adressen die de API mogen aanroepen (kommagescheiden)
CORS_ORIGINS=http://localhost:3000

# Claude API (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# claude-opus-5-5 (beste kwaliteit) of claude-sonnet-5-5 (goedkoper)
CLAUDE_MODEL=claude-opus-5-5
# Denkdiepte: low | medium | high
CLAUDE_EFFORT=medium
# Maximaal aantal AI-opdrachten per gebruiker per 24 uur
GENERATION_DAILY_LIMIT=100

# Supabase (Project Settings → API). De service role key alleen hier, nooit in de frontend.
SUPABASE_URL=https://jouw-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Alleen voor oudere projecten met een gedeeld JWT-geheim (HS256); nieuwe projecten laten dit leeg
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=logos

# Alleen deze e-mailadressen mogen een account gebruiken (kommagescheiden)
ALLOWED_EMAILS=jij@voorbeeld.nl
