# Kopieer naar backend/.env en vul in. Zet .env nooit in git.

# Database: lokaal SQLite; online de Postgres-connection string van Supabase
# (knop "Connect" → "Session pooler"; postgresql://... mag zo geplakt worden)
DATABASE_URL=sqlite:///./postpilot.db

# Frontend-adressen die de API mogen aanroepen (kommagescheiden)
CORS_ORIGINS=http://localhost:3000

# Welke AI-dienst de posts schrijft: gemini of claude
AI_PROVIDER=gemini

# Google Gemini (aistudio.google.com → Get API key)
GEMINI_API_KEY=
# gemini-flash-latest (snel en voordelig) of gemini-pro-latest (grondiger)
GEMINI_MODEL=gemini-flash-latest

# Anthropic Claude, alleen nodig bij AI_PROVIDER=claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Maximaal aantal AI-opdrachten per gebruiker per 24 uur
GENERATION_DAILY_LIMIT=100

# Supabase (Project Settings → API). De service role key alleen hier, nooit in de frontend.
SUPABASE_URL=https://jouw-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Alleen voor oudere projecten met een gedeeld JWT-geheim (HS256); nieuwe projecten laten dit leeg
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=logos

# Alleen deze e-mailadressen mogen een account gebruiken (kommagescheiden)
ALLOWED_EMAILS=jij@voorbeeld.nl

# Geheim voor het versleutelen van platform-tokens (minimaal 32 tekens). Maak er een met:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Publieke adressen: hier stuurt LinkedIn naar terug (backend) en hier draait de app (frontend)
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# LinkedIn-app (linkedin.com/developers → My apps → Auth)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202610

# X-app (developer.x.com → je app → User authentication settings: type "Web App", OAuth 2.0)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Meta (developers.facebook.com): Facebook-app voor pagina's, en het Instagram-app-ID/-geheim
# (App dashboard → Instagram → API setup with Instagram login)
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_GRAPH_VERSION=v26.0

# TikTok-app (developers.tiktok.com → Manage apps): Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
